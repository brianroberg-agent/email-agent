# API Proxy Configuration
# Copy this file to .env and fill in your values

# API key for authenticating with the proxy server
# Format: aproxy_<32-alphanumeric-characters>
PROXY_API_KEY=aproxy_your_api_key_here

# URL of the proxy server (optional - defaults to Docker host)
# PROXY_URL=http://host.docker.internal:8000

# Local LLM Configuration (optional)
# MLX_URL=http://localhost:8080/v1/chat/completions
# MLX_MODEL=qwen/qwen3-14b

# Cloud LLM Configuration (for person detection and non-person classification)
# Uses OpenAI-compatible API format
CLOUD_LLM_URL=https://api.novita.ai/v3/openai
CLOUD_LLM_API_KEY=your_api_key_here
CLOUD_LLM_MODEL=minimax/minimax-m2.1

# Sender Whitelist (comma-separated emails or domains)
# Emails from these senders always go to local MLX (never sent to cloud)
# Examples: person@example.com, @family-domain.com
# SENDER_WHITELIST=mom@gmail.com,@mycompany.com

# Classification Queue Settings
# QUEUE_DB_PATH=/app/data/classification.db
# QUEUE_RETENTION_DAYS=7

# Background Worker Settings
# WORKER_BATCH_SIZE=5
# WORKER_POLL_INTERVAL=10
